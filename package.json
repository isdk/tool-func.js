{
  "name": "@isdk/tool-func",
  "version": "1.0.0",
  "description": "A manager for creating, registering, and executing reusable tool functions with rich metadata.",
  "author": "Riceball LEE <snowyu.lee@gmail.com>",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "dependencies": {
    "@isdk/common-error": "workspace:^",
    "@isdk/hash": "workspace:^",
    "@isdk/util": "^0.3.11",
    "abstract-error": "^2.0.1",
    "custom-ability": "^2.3.1",
    "lodash-es": "^4.18.1",
    "property-manager": "^4.0.0",
    "util-ex": "^2.7.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.3.0",
    "@types/jest": "^30.0.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "~8.66.0",
    "esbuild-plugin-wasm": "^1.1.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-tsdoc": "^0.5.2",
    "eventsource": "^4.1.1",
    "fastify": "^5.11.3",
    "prettier": "^3.9.6",
    "terser": "^5.49.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "type-fest": "^5.8.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "~5.7.3",
    "vite": "^8.2.1",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^4.1.10"
  },
  "bug": "https://github.com/isdk/tool-func.js/issues",
  "files": [
    ".cache",
    "docs",
    "dist"
  ],
  "homepage": "https://github.com/isdk/tool-func.js/#readme",
  "keywords": [
    "tool-function",
    "function-calling",
    "ai-agent",
    "modular",
    "registry",
    "async",
    "stream",
    "cancellable",
    "isdk"
  ],
  "maintainers": [
    "Riceball LEE <snowyu.lee@gmail.com>"
  ],
  "engines": {
    "node": ">=20.11.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build-fast": "tsup",
    "build": "pnpm run build-fast --dts-resolve --dts && pnpm run doc:md",
    "clean": "rm -fr docs/api web dist",
    "doc": "typedoc --plugin none --out web",
    "doc:md": "typedoc --plugin typedoc-plugin-markdown --out docs/api",
    "style": "pnpm run format -c && pnpm run lint",
    "style:fix": "pnpm run format:fix && npm run lint:fix",
    "format": "prettier \"**/*.{ts,tsx,js,jsx,css,scss,sass,less,md}\"",
    "format:fix": "pnpm run format --write",
    "lint": "eslint .",
    "lint:fix": "pnpm run lint --fix",
    "test": "FORCE_COLOR=1 vitest run",
    "release": "pnpm run clean && pnpm run build && git add -f docs/api && git ci -m 'docs: update API docs' && pnpm dlx commit-and-tag-version -s",
    "release.alpha": "npm run release -- --prerelease alpha"
  },
  "types": "./dist/index.d.ts"
}
